{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "@core/*": [
        "./packages/core/src/*"
      ]
    }
  },
  "include": [
    "apps/web/src",
    "packages/core/src",
    "tools/**/*.ts",
    "tests",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
